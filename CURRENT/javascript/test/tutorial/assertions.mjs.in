import assert from 'node:assert/strict';
import {writeFileSync} from 'node:fs';
import {writeFile} from 'node:fs/promises';
const {initMxParser: initialize} = await import(process.env.MXPARSER_MODULE ?? '@mathparser.org/mxparser');
const definitions=BLOCKS;
import {readFileSync} from 'node:fs';
import {gunzipSync} from 'node:zlib';
const reference=JSON.parse(gunzipSync(readFileSync(new URL(REFERENCE))).toString('utf8'));
const {native,licenseNative}=reference;
const report={scope:'Every executable fence in the final public tutorial',status:'RUNNING',executed:0,passed:0,failed:0,examples:[]};
const output=console.log;let current,events=[],scriptEvents=[],scriptModes=[],nativeEvents=[],initializedModule,settingsBefore=0;
console.log=(...args)=>{scriptEvents.push(args);scriptModes.push(initializedModule?.mXparser.checkIfUlpRounding());events.push(args);};
const nativeOutput=text=>{nativeEvents.push([text]);events.push([text]);};
const initMxParser=async(options={})=>{initializedModule=await initialize({...options,print:nativeOutput,printErr:nativeOutput});return initializedModule;};
function begin(id){current=definitions.find(x=>x.id===id);events=[];scriptEvents=[];scriptModes=[];nativeEvents=[];report.executed++;if(current.nativeConsole||current.nativeStepsConsole||current.nativeVerbose)initializedModule.mXparser.resetConsoleOutput();}
function finish(settingsAfter=0){
 if(current.setting)assert.equal(settingsAfter-settingsBefore,current.settingAssertions,'All concrete native setting assertions actually executed');
 const references=native.filter(row=>row.id===current.id).sort((a,b)=>a.index-b.index);
 if(current.nativeReference){
   const expected=references.filter(row=>row.kind==='numeric'&&!(current.nativeLoop&&row.expression==='input'));
   const actual=scriptEvents.filter(row=>typeof row.at(-1)==='number');assert.equal(actual.length,expected.length);
   const modes=scriptModes.filter((_,index)=>typeof scriptEvents[index].at(-1)==='number');
   for(let i=0;i<expected.length;i++){
     assert.equal(modes[i],Boolean(expected[i].ulp),'Matching native rounding configuration at actual result emission, before cleanup');
     const bytes=new DataView(new ArrayBuffer(8));bytes.setBigUint64(0,BigInt('0x'+expected[i].bits),false);
     if(current.argumentValues){
       assert.equal(actual[i].length,4);assert.equal(actual[i][0],'x =');
       if(current.argumentValues[i]==='NaN')assert.ok(Number.isNaN(actual[i][1]),'Original displayed NaN argument');
       else assert.equal(actual[i][1],current.argumentValues[i],'Original displayed argument value');
     }
     assert.equal(actual[i][current.argumentValues?2:0],expected[i].expression,'Original expression source');
     assert.ok(Object.is(actual[i].at(-1),bytes.getFloat64(0,false)),current.id+': exact native reference result');
   }
 }
 if(current.nativeSerialization){
   const rows=references.filter(row=>row.kind.startsWith('serialization_'));
   const expectedCount=current.id==='C2-example-205'?5:current.id==='C2-example-209'?15:8;
   assert.equal(rows.length,expectedCount);assert.equal(scriptEvents.length,expectedCount,'Complete original serialization events');
   const number=bits=>{const view=new DataView(new ArrayBuffer(8));view.setBigUint64(0,BigInt('0x'+bits),false);return view.getFloat64(0,false);};
   const text=value=>value===null?null:new TextDecoder('utf-8',{fatal:true}).decode(new Uint8Array(value));
   for(let i=0;i<rows.length;i++){
     const row=rows[i],actual=scriptEvents[i];assert.equal(actual[0],row.label,'Original serialization event label/order');
     assert.equal(scriptModes[i],Boolean(row.ulp),'Matching native rounding mode at serialization output');
     assert.equal(actual.length,row.kind==='serialization_literal'?1:2);
     if(row.kind==='serialization_boolean')assert.equal(actual[1],Boolean(row.value));
     else if(row.kind==='serialization_text')assert.equal(actual[1],text(row.bytes),'Complete native diagnostic including original security warning');
     else if(row.kind==='serialization_number')assert.ok(Object.is(actual[1],number(row.bits)),'Exact original native restored calculation');
     else assert.equal(row.kind,'serialization_literal');
   }
 }
 if(current.nativeClone){
   const expected=references.filter(row=>row.kind==='clone_values');
   assert.equal(expected.length,{'C2-example-210':5,'C2-example-211':2,'C2-example-212':3,'C2-example-213':2,'C2-example-214':2}[current.id]);
   assert.equal(scriptEvents.length,expected.length,'Every original clone output row');
   for(let index=0;index<expected.length;index++){
     const row=expected[index],event=scriptEvents[index];assert.equal(event.length,1);assert.ok(Array.isArray(event[0]));assert.equal(event[0].length,row.bits.length);
     assert.equal(scriptModes[index],Boolean(row.ulp),'Matching original native rounding mode for clone calculations');
     for(let field=0;field<row.bits.length;field++){
       const view=new DataView(new ArrayBuffer(8));view.setBigUint64(0,BigInt('0x'+row.bits[field]),false);const value=view.getFloat64(0,false);
       if(row.mask&(1<<field)){assert.ok(value===0||value===1);assert.equal(event[0][field],Boolean(value),'Original native graph identity');}
       else assert.ok(Object.is(event[0][field],value),'Exact original native cloned graph value');
     }
   }
 }
 if(current.nativeLicense){
   const expected=licenseNative[current.id];assert.ok(expected,'Fresh original native license data is present');
   if(current.id==='C2-example-263'||current.id==='C2-example-265')assert.deepEqual(scriptEvents,[[expected.successful]]);
   else{
     const message=new TextDecoder('utf-8',{fatal:true}).decode(new Uint8Array(expected.message));
     assert.deepEqual(scriptEvents,[['isCallSuccessful =',expected.successful],['isConfirmed =',expected.confirmed],['message =',message]],'Exact native confirmation state and complete original message');
   }
 }
 if(current.nativeLocale){
   assert.equal(references.length,2);assert.equal(scriptEvents.length,2);
   const text=value=>value===null?null:new TextDecoder('utf-8',{fatal:true}).decode(new Uint8Array(value));
   for(let index=0;index<2;index++){
     const row=references[index],event=scriptEvents[index];assert.equal(row.kind,'locale_diagnostic');assert.equal(row.nan,true);
     assert.equal(event.length,1);assert.ok(Array.isArray(event[0]));assert.equal(event[0].length,3);
     assert.equal(event[0][0],text(row.expression));assert.ok(Number.isNaN(event[0][1]));
     assert.equal(event[0][2],text(row.error),'Complete original native localized diagnostic');
     assert.equal(scriptModes[index],Boolean(row.ulp));
   }
 }
 if(current.nativeHelpCounts){
   assert.equal(references.length,1);assert.equal(references[0].kind,'help_counts');
   assert.deepEqual(scriptEvents,[[references[0].values]],'All original native help byte/keyword counts');
   assert.equal(scriptModes[0],Boolean(references[0].ulp));
 }
 if(current.nativeHelpText){
   assert.equal(references.length,1);assert.equal(references[0].kind,'help_text');
   assert.ok(references[0].bytes!==null,'Native help result is present');
   const wanted=new TextDecoder('utf-8',{fatal:true}).decode(new Uint8Array(references[0].bytes));
   assert.deepEqual(scriptEvents,[[wanted]],'Complete original native formatted help text');
   assert.equal(scriptModes[0],Boolean(references[0].ulp));
 }
 if(current.nativeHelpKeywords){
   assert.equal(references.length,1);const expected=references[0];assert.equal(expected.kind,'help_keywords');
   assert.equal(expected.count,expected.words.length);assert.equal(scriptEvents.length,expected.count+1);
   assert.deepEqual(scriptEvents[0],[[expected.count]]);
   const text=value=>value===null?null:new TextDecoder('utf-8',{fatal:true}).decode(new Uint8Array(value));
   const labels=expected.labels.map(text);assert.equal(labels.length,5);
   const words=expected.words.map(word=>({labels,keyword:text(word.keyword),description:text(word.description),syntax:text(word.syntax),since:text(word.since),type:text(word.type),typeId:word.typeId,id:word.id}));
   assert.deepEqual(scriptEvents.slice(1),words.map(word=>[word]),'Every original keyword field, localized label, type description and row order');
   assert.ok(scriptModes.every(mode=>mode===Boolean(expected.ulp)));
 }
 if(current.nativeLoop){
   const benchmark=Number(current.id.slice(-3))>=180;
   if(!benchmark){
     const inputs=references.filter(row=>row.kind==='numeric'&&row.expression==='input');assert.equal(inputs.length,11);
     const actual=scriptEvents.filter(row=>row.length===1&&row[0]&&typeof row[0]==='object'&&Object.hasOwn(row[0],'input'));
     const number=bits=>{const view=new DataView(new ArrayBuffer(8));view.setBigUint64(0,BigInt('0x'+bits),false);return view.getFloat64(0,false);};
     assert.deepEqual(actual.map(row=>row[0]),inputs.map(row=>({input:number(row.bits)})),'All original loop input values in order');
   }else{
     const entries=scriptEvents.filter(row=>row.length===1&&row[0]?.benchmark===true);assert.equal(entries.length,1);
     const value=entries[0][0];assert.equal(value.numOfIter,10000000);assert.equal(value.evaluations,10000001);
     assert.ok(Number.isFinite(value.computingTimeSec)&&value.computingTimeSec>=0);
     assert.equal(value.iterationsPerSecond,value.computingTimeSec>0?value.numOfIter/value.computingTimeSec:null);
     const flags=references.filter(row=>row.kind==='rounding_flags');assert.equal(flags.length,1);
     assert.deepEqual([value.almost,value.ulp,value.canonical],flags[0].values.map(Boolean),'All three actual benchmark rounding modes');
   }
 }
 if(current.nativeRadix){
   const expected=references.filter(row=>row.kind==='radix');assert.equal(expected.length,1);
   const actual=scriptEvents.filter(row=>row.length===1&&typeof row[0]==='string');
   assert.deepEqual(actual,[[new TextDecoder('utf-8',{fatal:true}).decode(new Uint8Array(expected[0].bytes))]],'Original native radix conversion');
 }
 if(current.nativeSteps){
   const rows=references.filter(row=>row.kind==='steps');assert.equal(rows.length,1);const expected=rows[0];
   const text=value=>value===null?null:new TextDecoder('utf-8',{fatal:true}).decode(new Uint8Array(value));
   const number=bits=>{const bytes=new DataView(new ArrayBuffer(8));bytes.setBigUint64(0,BigInt('0x'+bits),false);return bytes.getFloat64(0,false);};
   const registerRows=scriptEvents.filter(row=>row[0]==='register');assert.equal(registerRows.length,1);
   const {computingTime,...actual}=registerRows[0][1];assert.ok(Number.isFinite(computingTime)&&computingTime>=0);
   const wanted={};for(const key of ['argumentNameStart','functionNameStart','expressionStringStart','errorMessage'])wanted[key]=text(expected[key]);
   wanted.result=number(expected.resultBits);assert.deepEqual(actual,wanted,'Every original native register value');
   const wantedRecords=expected.records.map(row=>({...row,typeText:text(row.typeText),description:text(row.description),content:text(row.content)}));
   assert.deepEqual(scriptEvents.filter(row=>row[0]==='step').map(row=>row[1]),wantedRecords,'Every original native step field and order');
   if(current.nativeStepsConsole){
     const wantedTrace=wantedRecords.map(row=>row.numberGroup+'.'+row.numberGroupWithin+' '+'   '.repeat(row.numberGroup-1)+row.typeText+' '+row.content);
     assert.deepEqual(scriptEvents.filter(row=>row[0]==='trace').map(row=>row[1]),wantedTrace,'Original hierarchical display');
     assert.ok(nativeEvents.length>0,'Native register actually printed');
     const normalizeTime=value=>{let matches=0;const result=value.replace(/(Computing time = )([0-9]+(?:\.[0-9]+)?(?:[eE][+-]?[0-9]+)?)( s\.)/g,(_,left,seconds,right)=>{matches++;assert.ok(Number.isFinite(Number(seconds))&&Number(seconds)>=0);return left+'<elapsed>'+right;});assert.equal(matches,1,'Exactly one native elapsed-time field');return result;};
     assert.equal(normalizeTime(initializedModule.mXparser.getConsoleOutput()),normalizeTime(text(expected.console)),'Complete native step console except actual elapsed seconds');
   }
 }
 if(current.nativeCanonical){
   const actual=scriptEvents.filter(row=>row.length===2&&row.every(value=>typeof value==='string'));
   assert.deepEqual(actual,references.map(row=>[row.expression,row.canonical]),'Original native canonical forms');
 }
 if(current.nativeCanonicalSyntax){
   assert.equal(references.length,15);
   const actual=scriptEvents.filter(row=>row.length===3&&typeof row[0]==='string'&&typeof row[1]==='string'&&typeof row[2]==='boolean');
   assert.deepEqual(actual,references.map(row=>[row.expression,row.canonical,Boolean(row.syntax)]),'All original canonical forms and syntax outcomes in order');
 }
 if(current.nativeBuiltin){
   const text=value=>value===null?null:new TextDecoder('utf-8',{fatal:true}).decode(new Uint8Array(value));
   const syntax=references.filter(row=>row.kind==='builtin_syntax');
   assert.equal(syntax.length,{'C2-example-168':4,'C2-example-169':5,'C2-example-170':3}[current.id]);
   assert.deepEqual(scriptEvents.filter(row=>row.length===1&&typeof row[0]==='boolean').map(row=>row[0]),syntax.map(row=>Boolean(row.syntax)),'All original settings syntax outcomes');
   assert.deepEqual(scriptEvents.filter(row=>row.length===1&&typeof row[0]==='string').map(row=>row[0]),syntax.map(row=>text(row.bytes)),'Every complete original settings diagnostic');
   const removed=references.filter(row=>row.kind==='builtin_values');
   assert.deepEqual(scriptEvents.filter(row=>row[0]==='removed').map(row=>row[1]),removed.map(row=>row.values.map(text)),'Original removed-name contents/order');
   const modified=references.filter(row=>row.kind==='builtin_table');
   assert.deepEqual(scriptEvents.filter(row=>row[0]==='modified').map(row=>row[1]),modified.map(row=>row.values.map(cells=>cells.map(text))),'Complete original nullable modification cells');
   const help=references.filter(row=>row.kind==='builtin_help');
   assert.deepEqual(scriptEvents.filter(row=>row[0]==='help').map(row=>row[1]),help.map(row=>text(row.bytes)),'Original and explicitly corrected native help queries');
   if(help.length)assert.ok(nativeEvents.length>0,'Native modified help emitted output');
   const flags=references.filter(row=>row.kind==='builtin_flag');
   assert.deepEqual(scriptEvents.filter(row=>row[0]==='override').map(row=>row[1]),flags.map(row=>Boolean(row.value)),'Original override mode');
 }
 if(current.nativeRounding){
   const expected=references.filter(row=>row.kind==='rounding_flags');assert.equal(expected.length,1);
   assert.deepEqual(scriptEvents.filter(row=>row.length===1&&typeof row[0]==='boolean').map(row=>row[0]),expected[0].values.map(Boolean),'Original almost-integer/ULP/canonical flags');
 }
 if(current.nativeVerbose){
   const rows=references.filter(row=>row.kind==='console');assert.equal(rows.length,1);
   assert.ok(nativeEvents.length>0,'Verbose engine actually emitted output');
   assert.equal(initializedModule.mXparser.getConsoleOutput(),new TextDecoder('utf-8',{fatal:true}).decode(new Uint8Array(rows[0].bytes)),'Complete original native verbose trace');
 }
 if(current.nativeText){
   assert.equal(references.length,1);assert.equal(references[0].kind,'text');
   const actual=scriptEvents.filter(row=>row.length===(current.nativeTextExpression?2:1)&&row.every(value=>typeof value==='string'));
   const text=new TextDecoder('utf-8',{fatal:true}).decode(new Uint8Array(references[0].bytes));
   assert.deepEqual(actual,[current.nativeTextExpression?[references[0].expression,text]:[text]],'Complete original native text value');
 }
 if(current.nativeConsole){
   assert.equal(references.length,1);assert.equal(references[0].kind,'console');
   assert.ok(nativeEvents.length>0,'Native console actually emitted output');
   assert.equal(initializedModule.mXparser.getConsoleOutput(),new TextDecoder('utf-8',{fatal:true}).decode(new Uint8Array(references[0].bytes)),'Complete original native console buffer');
 }
 if(current.nativeSyntax){
   assert.equal(references.length,1);const expected=references[0];
   const actual=scriptEvents.filter(row=>row.length===1&&typeof row[0]==='boolean').map(row=>row[0]);
   assert.deepEqual(actual,(expected.syntaxStates??[expected.syntax]).map(Boolean),'Original native syntax outcomes');
   const messages=scriptEvents.filter(row=>row.length===1&&typeof row[0]==='string').map(row=>row[0]);
   assert.deepEqual(messages,expected.errors.map(bytes=>new TextDecoder().decode(new Uint8Array(bytes))),'Exact original English native diagnostics');
 }
 if(current.nativeTokens){
   assert.equal(references.length,1);
   const actual=scriptEvents.filter(row=>row.length===1&&Array.isArray(row[0])).map(row=>row[0]);
   assert.deepEqual(actual,[references[0].tokens],'Original initial token strings including implied operators');
 }
 if(current.nativeMissing){
   assert.equal(references.length,1);
   const actual=scriptEvents.filter(row=>row.length===1&&Array.isArray(row[0])).map(row=>row[0]);
   assert.deepEqual(actual,[references[0].missing],'Original native missing argument names');
 }
 if(current.nativeMissingFunctions){
   assert.equal(references.length,1);
   const actual=scriptEvents.filter(row=>row.length===1&&Array.isArray(row[0])).map(row=>row[0]);
   assert.deepEqual(actual,[references[0].missingFunctions,references[0].missing],'Original native missing function/argument names');
 }
 for(const needle of current.nativeContains??[])assert.ok(events.flat().join('\\n').toLowerCase().includes(needle.toLowerCase()),current.id+': missing native help '+needle);
 report.passed++;report.examples.push({id:current.id,status:'PASS',chapter:current.chapter,case:current.case,outputs:events,script_outputs:scriptEvents,native_outputs:nativeEvents,native_reference:current.nativeReference??false,setting:current.setting??null,setting_assertions:current.setting?settingsAfter-settingsBefore:0});
 writeFileSync(new URL('./tutorial-progress.json',reportDirectory),JSON.stringify({executed:report.executed,passed:report.passed,last:current.id}));
}